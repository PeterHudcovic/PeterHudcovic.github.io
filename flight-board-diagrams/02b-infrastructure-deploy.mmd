flowchart TB

 BOOT["Terraform bootstrap (author, not in CI)<br/>APIs · service accounts · WIF<br/>Artifact Registry · state bucket · budget"]:::delivery
 TF["Main Terraform (author)<br/>VPC · subnet · router · NAT<br/>GKE · node pool · firewall · global IP"]:::delivery
 BUDGET["Budget 1000 CZK / month<br/>alerts 50 / 90 / 100 %<br/>no automatic spending stop"]:::ops
 OPS["Author steps (k8s/README.md)<br/>namespace → operator (Helm) → Secrets<br/>→ MongoDBCommunity + PDB → TLS Secret → RBAC"]:::ops
 MAIN["Merge to main"]:::app
 GATE["Deploy workflow<br/>push to main or manual dispatch<br/>infra/terraform change on push → skip<br/>(manual dispatch is not skipped)"]:::delivery
 DEPLOY["fb-deploy via WIF<br/>only main + workflow Deploy<br/>+ push or workflow_dispatch"]:::ops
 BUILD["Build backend + frontend images<br/>tag = full git SHA"]:::delivery
 REG["Artifact Registry flight-board<br/>fb-deploy: Writer · fb-nodes: Reader"]:::data
 API["GKE DNS endpoint<br/>fb-deploy: Kubernetes Engine Viewer"]:::ops
 RBAC["Role flight-board-deployer<br/>namespace flight-board only<br/>CRUD app objects + all Secrets<br/>no MongoDB / operator rights"]:::ops
 HELM["Check deployed version (fail-closed)<br/>helm upgrade --install · tag = SHA<br/>--wait --timeout 10m · no --atomic"]:::delivery
 VERIFY["Public /api/status = deployed SHA<br/>60 × 10 s · else workflow fails"]:::app
 DNSCF["Cloudflare A record → global IP<br/>(after first deploy)"]:::public
 NODES["fb-nodes on private node VMs<br/>default node role + AR Reader<br/>no JSON key"]:::ops
